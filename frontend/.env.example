# Frontend environment variables
# Renombrar a .env y configurar

# URL del backend (cambiar según tu caso)
VITE_API_URL=http://localhost:3001/api

# Para RED LOCAL, usar tu IP:
# VITE_API_URL=http://192.168.1.105:3001/api

# Para ngrok:
# VITE_API_URL=https://abc123.ngrok.io/api

# Para producción:
# VITE_API_URL=https://tu-prode-backend.railway.app/api

