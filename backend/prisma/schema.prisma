generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  avatar      String
  color       String       @default("#75AADB")
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  predictions Prediction[]

  @@map("users")
}

model Match {
  id              Int          @id @default(autoincrement())
  apiFootballId   Int?         @unique
  homeTeam        String
  awayTeam        String
  homeFlag        String       @default("🏴")
  awayFlag        String       @default("🏴")
  date            DateTime     @db.Timestamp(6)
  stadium         String?
  stage           String
  group           String?
  homeScore       Int?
  awayScore       Int?
  status          String       @default("scheduled")
  isPronosticable Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamp(6)
  updatedAt       DateTime     @updatedAt @db.Timestamp(6)
  predictions     Prediction[]

  @@map("matches")
}

model Prediction {
  id                 Int      @id @default(autoincrement())
  userId             Int
  matchId            Int
  predictedHomeScore Int
  predictedAwayScore Int
  points             Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @db.Timestamp(6)
  match              Match    @relation(fields: [matchId], references: [id])
  user               User     @relation(fields: [userId], references: [id])

  @@unique([userId, matchId])
  @@map("predictions")
}

model Prode {
  id          Int      @id @default(autoincrement())
  name        String   @default("Prode Mundial 2026 🇦🇷")
  description String   @default("Pronósticos del equipo para el Mundial 2026")
  startDate   DateTime @db.Timestamp(6)
  endDate     DateTime @db.Timestamp(6)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  @@map("prode")
}
